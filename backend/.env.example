# Copy to backend/.env. For production: DJANGO_DEBUG=0, long random DJANGO_SECRET_KEY, SECURE_SSL_REDIRECT=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
SECURE_SSL_REDIRECT=0
DATABASE_URL=postgres://talent:talent@db:5432/talentgauge
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
# EMAIL_HOST=smtp.example.com   (leave unset to print emails to the console)
